# ---------------------------------------------------------------------
#  Copiez ce fichier en .env (cp .env.example .env), puis remplissez les valeurs.
#  Sur Vercel : ajoutez ces variables dans Settings → Environment Variables,
#  puis redéployez.
# ---------------------------------------------------------------------

# Clés autorisées à appeler VOTRE API, séparées par des virgules (une par projet).
# Générez-les avec :
#   node -e "console.log(crypto.randomUUID().replaceAll('-', '') + crypto.randomUUID().replaceAll('-', ''))"
# Minimum 16 caractères. N'utilisez JAMAIS les valeurs d'exemple d'un dépôt public.
GATEWAY_KEYS=

# Fournisseurs (laissez vide pour désactiver)
GROQ_API_KEY=
GEMINI_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Modèles (optionnel). Plusieurs modèles possibles, séparés par des virgules :
# ils sont essayés dans l'ordre. Les noms de modèles changent souvent : vérifiez
# les pages « deprecations » de chaque fournisseur.
#   Groq : modèles à essayer en premier ; les autres modèles de chat actifs suivent, du plus grand au plus petit.
#   Un identifiant retiré ou mal écrit est ignoré, avec un avertissement dans les journaux.
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash-lite
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8

# Délais (optionnel)
#   TIMEOUT_MS  : durée maximale d'UNE tentative chez un fournisseur (défaut 20000, minimum 500)
#   DEADLINE_MS : durée maximale TOTALE d'une requête, tentatives de secours comprises (défaut 50000, minimum 1000).
#                 À garder sous « maxDuration » de vercel.json (60 s) ; à baisser si votre plan Vercel limite à 10 s.
TIMEOUT_MS=20000
DEADLINE_MS=50000

# Autres réglages (optionnel)
#   MAX_BODY_BYTES : taille maximale du corps d'une requête (défaut 4194304 = 4 Mo)
#   CORS_ORIGINS   : origines autorisées pour les navigateurs, séparées par des virgules (défaut *)
#                    ex. https://mon-site.com,https://app.mon-site.com
#   LOG_LEVEL      : silent | error | warn | info (défaut info)
#   *_BASE_URL     : adresse de l'API d'un fournisseur, pour passer par un proxy (défaut : l'adresse officielle)
# MAX_BODY_BYTES=4194304
# CORS_ORIGINS=*
# LOG_LEVEL=info
# GROQ_BASE_URL=
# GEMINI_BASE_URL=
# CLOUDFLARE_BASE_URL=
