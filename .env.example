# Clés autorisées à appeler TON API (séparées par des virgules, une par projet)
GATEWAY_KEYS=cle-projet-1,cle-projet-2

# Fournisseurs (laisse vide pour désactiver)
GROQ_API_KEY=
GEMINI_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Optionnel
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.5-flash
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct
TIMEOUT_MS=20000
